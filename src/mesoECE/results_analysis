import xgboost as xgb
import matplotlib.pyplot as plt
from sklearn.datasets import load_iris
import pandas as pd
import numpy as np

# Load data
iris = load_iris()
X = iris.data
y = iris.target

# Initialize and fit the model
model_xgb = xgb.XGBClassifier(use_label_encoder=False, eval_metric='mlogloss')
model_xgb.fit(X, y)

# Extract feature importance
feature_importances_xgb = model_xgb.feature_importances_

# Visualizing Feature Importance
features = iris.feature_names
indices = np.argsort(feature_importances_xgb)

plt.title('Feature Importances in XGBoost')
plt.barh(range(len(indices)), feature_importances_xgb[indices], color='r', align='center')
plt.yticks(range(len(indices)), [features[i] for i in indices])
plt.xlabel('Relative Importance')
plt.show()